---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const WEB3FORMS_KEY = '281f477d-7744-407d-9b6a-9b8d9c6abe3c';
const TURNSTILE_SITEKEY = '0x4AAAAAAEeNMUmwDjh2lpsD';
---
<BaseLayout
  title="Contact | Beste-energievergelijker.com"
  description="Vragen over energie vergelijken of overstappen? Neem contact op met de klantenservice van Beste-energievergelijker.com; we staan elke dag voor je klaar."
>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs"><a href="/">Home</a><span>/</span><span style="opacity:1">Contact</span></p>
      <h1>Vragen over energie vergelijken?</h1>
      <p>
        Domme vragen bestaan niet. We staan graag voor je klaar om al je vragen over vergelijken, overstappen en
        tarieven te beantwoorden.
      </p>
    </div>
  </section>

  <div class="article">
    <div class="wrap article-layout">
      <article>
        <div class="prose" style="margin-bottom:34px">
          <h2 style="margin-top:0">Stuur ons een bericht</h2>
          <p>
            Heb je een vraag voor ons team? Vul het formulier hieronder in, dan nemen we zo snel mogelijk contact met
            je op. Liever mailen? Dat kan ook, via
            <a href="mailto:info@beste-energievergelijker.com">info@beste-energievergelijker.com</a>.
          </p>
        </div>

        <ContactForm
          accessKey={WEB3FORMS_KEY}
          turnstileSiteKey={TURNSTILE_SITEKEY}
          subject="Nieuw bericht via Beste-energievergelijker.com"
          siteName="Beste-energievergelijker.com"
        />

        <div class="prose" style="margin-top:40px">
          <h2>Altijd een antwoord</h2>
          <p>
            We beantwoorden vragen over het vergelijken van energieleveranciers, het overstapproces, energietarieven en
            de informatie op deze site. Gaat je vraag over een lopend contract of een factuur? Neem dan rechtstreeks
            contact op met je energieleverancier &mdash; zij hebben je klantgegevens en kunnen je direct helpen.
          </p>
        </div>
      </article>

      <aside class="aside">
        <div class="box accent">
          <h3>Zo helpen we je verder</h3>
          <p>Vul het contactformulier in, of stuur een e-mail. We reageren doorgaans binnen één werkdag.</p>
          <a class="btn no-arrow" href="mailto:info@beste-energievergelijker.com">Mail ons</a>
        </div>
        <div class="box">
          <h3>Misschien staat je antwoord er al</h3>
          <div class="links">
            <a href="/kennisbank/">Kennisbank</a>
            <a href="/energie-vergelijken/">Energie vergelijken</a>
            <a href="/overstappen-energie/">Overstappen energie</a>
            <a href="/energie-aanbieders/">Alle energie aanbieders</a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
