---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Pagina niet gevonden | Beste-energievergelijker.com" noindex={true}>
  <section class="page-hero">
    <div class="wrap">
      <h1>Deze pagina bestaat niet (meer)</h1>
      <p>De pagina die je zocht is verplaatst of verwijderd. Hieronder vind je de meest gebruikte pagina's.</p>
    </div>
  </section>
  <section>
    <div class="wrap">
      <div class="grid grid-3">
        <a class="card" href="/"><h3>Energie vergelijken</h3><p>Start direct de vergelijking op de homepage.</p></a>
        <a class="card" href="/energie-aanbieders/"><h3>Energie aanbieders</h3><p>Alle leveranciers op een rij.</p></a>
        <a class="card" href="/kennisbank/"><h3>Kennisbank</h3><p>Alle energiebegrippen uitgelegd.</p></a>
        <a class="card" href="/overstappen-energie/"><h3>Overstappen</h3><p>Zo stap je over van energieleverancier.</p></a>
        <a class="card" href="/zakelijke-energie/"><h3>Zakelijke energie</h3><p>Vergelijken voor bedrijven.</p></a>
        <a class="card" href="/contact/"><h3>Contact</h3><p>Neem contact met ons op.</p></a>
      </div>
    </div>
  </section>
</BaseLayout>
