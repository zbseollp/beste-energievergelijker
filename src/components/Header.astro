---
const { pathname } = Astro.url;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/energie-vergelijken/', label: 'Energie vergelijken' },
  { href: '/overstappen-energie/', label: 'Overstappen energie' },
  { href: '/energie-aanbieders/', label: 'Energie aanbieders' },
  { href: '/zakelijke-energie/', label: 'Zakelijke energie' },
  { href: '/kennisbank/', label: 'Kennisbank' },
  { href: '/blog/', label: 'Blog' },
];
---
<header class="site-header">
  <div class="wrap hdr">
    <a class="logo" href="/" aria-label="Beste-energievergelijker.com">
      <img src="/wp-content/uploads/2022/06/cropped-logo-2.png" alt="Beste-energievergelijker.com" width="336" height="138" />
    </a>
    <button class="burger" id="burger" aria-label="Menu openen" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav id="nav">
      {nav.map((n) => <a href={n.href} class={pathname === n.href ? 'active' : ''}>{n.label}</a>)}
      <a class="btn" href="/#vergelijker">Vergelijken</a>
    </nav>
  </div>
</header>
<script is:inline>
  (function () {
    var b = document.getElementById('burger');
    var n = document.getElementById('nav');
    if (!b || !n) return;
    b.addEventListener('click', function () {
      var open = n.classList.toggle('open');
      b.setAttribute('aria-expanded', String(open));
    });
  })();
</script>
